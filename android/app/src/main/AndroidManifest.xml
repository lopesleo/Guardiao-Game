<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- appCategory="game": no Android 16+, jogos ficam fora da regra que ignora a orientação travada em tela
         grande (tablet/dobrável); o jogo é só deitado (sensorLandscape) -->
    <application
        android:appCategory="game"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Firebase só coleta depois que o jogo liga (Telemetry.install) e se o jogador não desligou -->
        <!-- AdMob: ID do app (conta do desenvolvedor). Não é segredo. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-7068898840847782~4241412114" />
        <!-- Play Games (progresso na nuvem): ID em res/values/games-ids.xml; vazio = desligado -->
        <meta-data android:name="com.google.android.gms.games.APP_ID" android:value="@string/game_services_project_id" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <!-- Novidades (FCM, src/systems/News.js): sem token até o jogador aceitar; canal "novidades" criado pelo
             jogo com o nome no idioma dele; ícone pequeno e cor das notificações (também dos lembretes) -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="novidades" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_guardiao" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/guardiao_notificacao" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Play Games: sem a inicialização automática da biblioteca. Quem inicializa é o
             PlayGamesPlugin, e só quando há ID (sem ID o app nunca toca no Play Games) -->
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Compra "Sem anúncios" (Play Billing; ver src/systems/Billing.js) -->
    <uses-permission android:name="com.android.vending.BILLING" />
</manifest>
