{
  "name": "guardiao-da-floresta",
  "version": "1.0.0",
  "private": true,
  "description": "Guardião da Floresta — survivor-like de reações elementais (Phaser 4).",
  "type": "module",
  "scripts": {
    "serve": "npx serve . -l 8000",
    "build": "node tools/build-www.mjs",
    "balance": "node tools/balance-report.mjs",
    "check": "node tools/check-content.mjs",
    "test": "node tools/test-toque.mjs && node tools/test-compra.mjs && node tools/test-avisos.mjs && node tools/test-rankings.mjs && node tools/test-audio.mjs",
    "test:toque": "node tools/test-toque.mjs",
    "test:compra": "node tools/test-compra.mjs",
    "test:avisos": "node tools/test-avisos.mjs",
    "test:rankings": "node tools/test-rankings.mjs",
    "test:audio": "node tools/test-audio.mjs",
    "play:produtos": "node tools/play-produtos.mjs",
    "play:versao": "node tools/play-versao.mjs",
    "play:imagens": "node tools/play-imagens.mjs",
    "aviso": "node tools/play-aviso.mjs",
    "play:rankings": "node tools/play-rankings.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:install": "node tools/android-install.mjs",
    "android:chave": "node tools/android-key.mjs",
    "android:apk": "node tools/android-release.mjs apk",
    "android:aab": "node tools/android-release.mjs aab",
    "icons": "npx @capacitor/assets generate --android --assetPath resources --iconBackgroundColor '#10202a' --splashBackgroundColor '#070b14'"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor-firebase/crashlytics": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/native-purchases": "8.8.1",
    "firebase": "^12.19.0"
  }
}
